# Public project configuration. Use a Supabase publishable/anon key, never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required trusted origin for confirmation/magic-link redirects.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Optional server-only integrations. Enter real values through secure environment settings.
# The supported proxy-secret target PRIMEFIT_AI_KEY takes precedence over OPENAI_API_KEY.
PRIMEFIT_AI_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=
