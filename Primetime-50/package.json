{
  "name": "primefit-50-plus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:sql": "node scripts/test-sql.mjs",
    "test:e2e": "playwright test",
    "db:start": "supabase start -x studio,imgproxy,realtime,storage-api,edge-runtime,logflare,vector,supavisor",
    "db:reset": "supabase db reset --local",
    "db:stop": "supabase stop",
    "db:types": "node scripts/db-types.mjs",
    "dev:local": "node scripts/local-env.mjs && next dev --hostname 0.0.0.0 --port 3000",
    "test:guards": "playwright test --project guards",
    "test:security": "vitest run --project security"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "@stripe/stripe-js": "^4.5.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.45.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "openai": "^4.73.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.13.3",
    "server-only": "^0.0.1",
    "stripe": "^17.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "postgres": "^3.4.9",
    "supabase": "2.119.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  }
}
